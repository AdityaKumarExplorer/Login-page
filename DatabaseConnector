import java.io.*;
import java.sql.*;

class DatabaseConnector {

    private String url = "jdbc:mysql://localhost:3306/users";
    private String username = "root";
    private String password = "new_password";

    Class.forName("com.mysql.cj.jdbc.Driver");
    Connection con = DriverManager.getConnection(url, username, password);
    
    void insert(string e, string p) {
        try {
            String query = "INSERT INTO user VALUES (?, ?)";
            PreparedStatement pstmt = con.prepareStatement(query);

            pstmt.setString(1, e);
            pstmt.setString(2, p);

            int rows = pstmt.executeUpdate();

            if (rows > 0) {
                System.out.println("1 record inserted");
            }

            pstmt.close();
            con.close();

        } catch (Exception e) {
            System.out.println(e.getMessage());
        }

    void update(string e, string p) {
        try {
            String query = "UPDATE user SET password = ? WHERE email = ?";
            PreparedStatement pstmt = con.prepareStatement(query);

            pstmt.setString(1, p);
            pstmt.setString(2, e);

            int rows = pstmt.executeUpdate();

            if (rows > 0) {
                System.out.println("Record updated successfully");
            } else {
                System.out.println("Record not found");
            }

            pstmt.close();
            con.close();

        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

    void delete(string e) {
        try {
            String query = "DELETE FROM user WHERE email = ?";
            PreparedStatement pstmt = con.prepareStatement(query);

            pstmt.setString(1, e);

            int rows = pstmt.executeUpdate();

            if (rows > 0) {
                System.out.println("Record deleted successfully");
            } else {
                System.out.println("Record not found");
            }

            pstmt.close();
            con.close();

        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

    public static void main(String[] args) {
    DatabaseConnector db = new DatabaseConnector();
    Scanner sc = new Scanner(System.in);

    System.out.println("Select Action: Login, Register, Forget Password");
    int choice = sc.nextLine();
    
    switch (choice) {
        case 1: // LOGIN (Check Availability)
            System.out.print("Enter Email: ");
            String loginEmail = sc.nextLine();
            System.out.print("Enter Password: ");
            String loginPass = sc.nextLine();
            db.checkLogin(loginEmail, loginPass);
            break;

        case 2: // REGISTER (Check existence then insert)
            System.out.print("Enter Email: ");
            String regEmail = sc.nextLine();
            System.out.print("Enter Password: ");
            String regPass = sc.nextLine();
            db.registerUser(regEmail, regPass);
            break;

        case 3: // FORGET PASSWORD (Update)
            System.out.print("Enter Email: ");
            String resetEmail = sc.nextLine();
            System.out.print("Enter New Password: ");
            String newPass = sc.nextLine();
            db.update(resetEmail, newPass);
            break;

        default:
            System.out.println("Invalid choice.");
    }
}